{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "webspacey",
  "main": "./worker.js",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
